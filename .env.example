DISCORD_TOKEN=
# ELVNX-PVT: commands and gateway actions are restricted to this guild.
DISCORD_GUILD_ID=1554095197959491595
DATABASE_URL=sqlite://data/elvnx.db
REGISTER_COMMANDS=false
# Optional private audio node; omit both variables when music is disabled.
# LAVALINK_URL=http://127.0.0.1:2333
# LAVALINK_PASSWORD=server-only-generated-password
BOT_SUPERVISED=false
# Enable in the Developer Portal before enabling these locally.
ENABLE_MESSAGE_CONTENT=false
ENABLE_MEMBER_EVENTS=false
ENABLE_PRESENCE_EVENTS=false
RUST_LOG=elvnx_bot=info,warn
# Automatic member REST + WebSocket presence. Always binds to 127.0.0.1; use HTTPS tunnel.
PRESENCE_API_ENABLED=false
PRESENCE_API_PORT=4100

